{
  "name": "meishi-kanri",
  "version": "1.0.0",
  "private": true,
  "description": "社内サーバーで動く個人用名刺管理アプリ（外部通信なし）",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client && node scripts/copy-vendor.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "npm run build:server && node --test --test-concurrency=1 dist/test/*.test.js",
    "start": "node dist/server/main.js",
    "init-store": "node dist/server/cli.js init-store",
    "check-config": "node dist/server/cli.js check",
    "package": "npm run build && node scripts/package.mjs",
    "user": "node dist/server/cli.js user"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "@types/node": "22.20.5",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "typescript": "5.9.3"
  }
}
